{
  "openapi": "3.0.3",
  "info": {
    "title": "WhatsApp Gateway API",
    "description": "REST API untuk WhatsApp Gateway dengan engine Baileys & whatsapp-web.js",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "security": [{ "apiKey": [] }],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Success": { "type": "object", "properties": { "success": { "type": "boolean" } } },
      "Error": { "type": "object", "properties": { "success": { "type": "boolean", "enum": [false] }, "error": { "type": "string" } } },
      "Session": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "engine": { "type": "string", "enum": ["baileys", "wwjs"] },
          "status": { "type": "string", "enum": ["created", "qr_pending", "authenticating", "connected", "disconnected", "error"] },
          "phone": { "type": "string" }, "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }
        }
      },
      "MessageSend": {
        "type": "object",
        "required": ["sessionId", "to"],
        "properties": {
          "sessionId": { "type": "string" }, "to": { "type": "string" },
          "text": { "type": "string" }, "mediaUrl": { "type": "string" },
          "mediaType": { "type": "string", "enum": ["image", "video", "document", "audio"] },
          "caption": { "type": "string" },
          "location": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
          "reaction": { "type": "object", "properties": { "text": { "type": "string" }, "messageId": { "type": "string" } } },
          "poll": { "type": "object", "properties": { "name": { "type": "string" }, "values": { "type": "array", "items": { "type": "string" } }, "selectableCount": { "type": "number" } } },
          "contacts": { "type": "object", "properties": { "displayName": { "type": "string" }, "contacts": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "phone": { "type": "string" } } } } } },
          "forward": { "type": "object", "properties": { "messageId": { "type": "string" }, "chatJid": { "type": "string" } } },
          "quoted": { "type": "object", "properties": { "messageId": { "type": "string" }, "chatJid": { "type": "string" } } },
          "mentions": { "type": "array", "items": { "type": "string" } },
          "disappearingMessages": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "duration": { "type": "number" } } },
          "ephemeralExpiration": { "type": "number" }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "url": { "type": "string" }, "events": { "type": "array", "items": { "type": "string" } },
          "secret": { "type": "string" }, "active": { "type": "boolean" }, "createdAt": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": { "tags": ["Health"], "summary": "Health check", "responses": { "200": { "description": "Server running" } } }
    },
    "/session": {
      "get": { "tags": ["Session"], "summary": "List semua session", "responses": { "200": { "description": "Success" } } },
      "post": {
        "tags": ["Session"], "summary": "Buat session baru",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "engine"], "properties": { "name": { "type": "string" }, "engine": { "type": "string", "enum": ["baileys", "wwjs"] } } } } } },
        "responses": { "200": { "description": "Session created" } }
      }
    },
    "/session/{id}": {
      "get": { "tags": ["Session"], "summary": "Detail session", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Success" }, "404": { "description": "Not found" } } },
      "delete": { "tags": ["Session"], "summary": "Hapus session", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Deleted" } } }
    },
    "/session/{id}/qr": {
      "get": { "tags": ["Session"], "summary": "Dapatkan QR code", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "QR code" } } }
    },
    "/session/{id}/pairing": {
      "post": {
        "tags": ["Session"], "summary": "Request pairing code (tanpa QR)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["phone"], "properties": { "phone": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Pairing code" } }
      }
    },
    "/session/{id}/connect": {
      "post": { "tags": ["Session"], "summary": "Connect session", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Connecting" } } }
    },
    "/session/{id}/disconnect": {
      "post": { "tags": ["Session"], "summary": "Disconnect session", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Disconnected" } } }
    },
    "/message/check/{sessionId}/{phone}": {
      "get": { "tags": ["Message"], "summary": "Check nomor WhatsApp", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "phone", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Check result" } } }
    },
    "/message/send": {
      "post": { "tags": ["Message"], "summary": "Kirim pesan", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageSend" } } } }, "responses": { "200": { "description": "Message sent" }, "400": { "description": "Invalid" }, "429": { "description": "Rate limit" } } }
    },
    "/message/delete": {
      "post": { "tags": ["Message"], "summary": "Hapus pesan", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "messageId"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "messageId": { "type": "string" } } } } } }, "responses": { "200": { "description": "Deleted" } } }
    },
    "/message/edit": {
      "post": { "tags": ["Message"], "summary": "Edit pesan (Baileys only)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "messageId", "text"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "messageId": { "type": "string" }, "text": { "type": "string" } } } } } }, "responses": { "200": { "description": "Edited" } } }
    },
    "/message/read": {
      "post": { "tags": ["Message"], "summary": "Mark sebagai read", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "messageIds"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "messageIds": { "type": "array", "items": { "type": "string" } } } } } } }, "responses": { "200": { "description": "Marked as read" } } }
    },
    "/message/presence": {
      "post": { "tags": ["Message"], "summary": "Kirim presence (typing indicator)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "presence"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "presence": { "type": "string", "enum": ["available", "unavailable", "composing", "recording", "paused"] } } } } } }, "responses": { "200": { "description": "Presence updated" } } }
    },
    "/message/presence/subscribe": {
      "post": { "tags": ["Message"], "summary": "Subscribe presence updates", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" } } } } } }, "responses": { "200": { "description": "Subscribed" } } }
    },
    "/message/download": {
      "post": { "tags": ["Message"], "summary": "Download media dari pesan", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "msg"], "properties": { "sessionId": { "type": "string" }, "msg": { "type": "object" }, "type": { "type": "string", "enum": ["buffer", "stream"] } } } } } }, "responses": { "200": { "description": "Media data" } } }
    },
    "/contacts/{sessionId}": {
      "get": { "tags": ["Contacts"], "summary": "List kontak", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Contacts list" } } }
    },
    "/chats/{sessionId}": {
      "get": { "tags": ["Chats"], "summary": "List chats", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Chats list" } } }
    },
    "/chats/{sessionId}/{chatJid}/messages": {
      "get": { "tags": ["Chats"], "summary": "Riwayat pesan per chat", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "chatJid", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "limit", "in": "query", "schema": { "type": "number", "default": 50 } }, { "name": "offset", "in": "query", "schema": { "type": "number", "default": 0 } }], "responses": { "200": { "description": "Messages" } } }
    },
    "/chats/{sessionId}/stats": {
      "get": { "tags": ["Chats"], "summary": "Statistik chat", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Stats" } } }
    },
    "/chats/{sessionId}/{chatJid}/profile": {
      "get": { "tags": ["Chats"], "summary": "Profile picture", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "chatJid", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Profile URL" } } }
    },
    "/chats/archive": {
      "post": { "tags": ["Chats"], "summary": "Archive/unarchive chat", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "archive"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "archive": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "Archived" } } }
    },
    "/chats/mute": {
      "post": { "tags": ["Chats"], "summary": "Mute/unmute chat", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "durationMs": { "type": "number" } } } } } }, "responses": { "200": { "description": "Muted" } } }
    },
    "/chats/pin": {
      "post": { "tags": ["Chats"], "summary": "Pin/unpin chat", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "pin"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "pin": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "Pinned" } } }
    },
    "/chats/delete": {
      "post": { "tags": ["Chats"], "summary": "Hapus chat", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" } } } } } }, "responses": { "200": { "description": "Deleted" } } }
    },
    "/chats/star": {
      "post": { "tags": ["Chats"], "summary": "Star/unstar pesan", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "chatJid", "messageId", "fromMe", "star"], "properties": { "sessionId": { "type": "string" }, "chatJid": { "type": "string" }, "messageId": { "type": "string" }, "fromMe": { "type": "boolean" }, "star": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "Starred" } } }
    },
    "/chats/profile-name": {
      "post": { "tags": ["Chats"], "summary": "Update profile name", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "name"], "properties": { "sessionId": { "type": "string" }, "name": { "type": "string" } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/chats/profile-status": {
      "post": { "tags": ["Chats"], "summary": "Update profile status", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "status"], "properties": { "sessionId": { "type": "string" }, "status": { "type": "string" } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/chats/fetch-history": {
      "post": { "tags": ["Chats"], "summary": "Fetch history on-demand", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "count", "oldestMsgKey", "oldestMsgTimestamp"], "properties": { "sessionId": { "type": "string" }, "count": { "type": "number" }, "oldestMsgKey": { "type": "object" }, "oldestMsgTimestamp": { "type": "number" } } } } } }, "responses": { "200": { "description": "History fetched" } } }
    },
    "/groups/create": {
      "post": { "tags": ["Groups"], "summary": "Buat grup baru", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "subject", "participants"], "properties": { "sessionId": { "type": "string" }, "subject": { "type": "string" }, "participants": { "type": "array", "items": { "type": "string" } } } } } } }, "responses": { "200": { "description": "Group created" } } }
    },
    "/groups/{sessionId}/{jid}/metadata": {
      "get": { "tags": ["Groups"], "summary": "Group metadata", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Metadata" } } }
    },
    "/groups/participants": {
      "post": {
        "tags": ["Groups"], "summary": "Add/Remove/Promote/Demote participants",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "participants", "action"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "participants": { "type": "array", "items": { "type": "string" } }, "action": { "type": "string", "enum": ["add", "remove", "promote", "demote"] } } } } } },
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/groups/subject": {
      "post": { "tags": ["Groups"], "summary": "Update nama grup", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "subject"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "subject": { "type": "string" } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/groups/description": {
      "post": { "tags": ["Groups"], "summary": "Update deskripsi grup", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "description"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "description": { "type": "string" } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/groups/settings": {
      "post": { "tags": ["Groups"], "summary": "Update group settings", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "setting"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "setting": { "type": "string", "enum": ["announcement", "not_announcement", "locked", "unlocked"] } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/groups/leave": {
      "post": { "tags": ["Groups"], "summary": "Leave grup", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" } } } } } }, "responses": { "200": { "description": "Left" } } }
    },
    "/groups/{sessionId}/{jid}/invite": {
      "get": { "tags": ["Groups"], "summary": "Dapatkan invite code", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Invite code" } } }
    },
    "/groups/invite/revoke": {
      "post": { "tags": ["Groups"], "summary": "Revoke invite code", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" } } } } } }, "responses": { "200": { "description": "New code" } } }
    },
    "/groups/invite/join": {
      "post": { "tags": ["Groups"], "summary": "Join grup via invite code", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "code"], "properties": { "sessionId": { "type": "string" }, "code": { "type": "string" } } } } } }, "responses": { "200": { "description": "Joined" } } }
    },
    "/groups/invite/info/{sessionId}/{code}": {
      "get": { "tags": ["Groups"], "summary": "Invite info", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Info" } } }
    },
    "/groups/ephemeral": {
      "post": { "tags": ["Groups"], "summary": "Toggle ephemeral messages", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "duration"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "duration": { "type": "number" } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/groups/member-add-mode": {
      "post": { "tags": ["Groups"], "summary": "Set member add mode", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "mode"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "mode": { "type": "string", "enum": ["all_member_add", "admin_add"] } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },
    "/groups/{sessionId}/all": {
      "get": { "tags": ["Groups"], "summary": "Fetch semua grup", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Groups" } } }
    },
    "/groups/{sessionId}/{jid}/requests": {
      "get": { "tags": ["Groups"], "summary": "List join requests", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Requests" } } }
    },
    "/groups/requests": {
      "post": { "tags": ["Groups"], "summary": "Approve/reject join requests", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid", "participants", "action"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "participants": { "type": "array", "items": { "type": "string" } }, "action": { "type": "string", "enum": ["approve", "reject"] } } } } } }, "responses": { "200": { "description": "Processed" } } }
    },
    "/broadcast/send": {
      "post": { "tags": ["Broadcast"], "summary": "Kirim broadcast", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" }, "text": { "type": "string" }, "mediaUrl": { "type": "string" }, "mediaType": { "type": "string" }, "backgroundColor": { "type": "string" }, "font": { "type": "number" } } } } } }, "responses": { "200": { "description": "Sent" } } }
    },
    "/broadcast/status": {
      "post": { "tags": ["Broadcast"], "summary": "Kirim status/stories", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "statusJidList"], "properties": { "sessionId": { "type": "string" }, "statusJidList": { "type": "array", "items": { "type": "string" } }, "text": { "type": "string" }, "mediaUrl": { "type": "string" }, "mediaType": { "type": "string" }, "backgroundColor": { "type": "string" }, "font": { "type": "number" } } } } } }, "responses": { "200": { "description": "Status posted" } } }
    },
    "/broadcast/info/{sessionId}/{jid}": {
      "get": { "tags": ["Broadcast"], "summary": "Broadcast list info", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Info" } } }
    },
    "/privacy/{sessionId}": {
      "get": { "tags": ["Privacy"], "summary": "Get privacy settings", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Settings" } } }
    },
    "/privacy/{sessionId}/blocklist": {
      "get": { "tags": ["Privacy"], "summary": "Get blocklist", "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Blocklist" } } }
    },
    "/privacy/block": {
      "post": { "tags": ["Privacy"], "summary": "Block user", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" } } } } } }, "responses": { "200": { "description": "Blocked" } } }
    },
    "/privacy/unblock": {
      "post": { "tags": ["Privacy"], "summary": "Unblock user", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sessionId", "jid"], "properties": { "sessionId": { "type": "string" }, "jid": { "type": "string" } } } } } }, "responses": { "200": { "description": "Unblocked" } } }
    },
    "/privacy/last-seen": {
