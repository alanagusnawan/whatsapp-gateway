# Server
PORT=3000
HOST=0.0.0.0

# WhatsApp Engine: baileys | wwjs
WA_ENGINE=baileys

# Auth
API_KEY=your-secret-api-key

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_gateway

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage
DATA_DIR=./data

# Puppeteer (engine wwjs only)
# Isi dengan path Chromium/Chrome sistem di Ubuntu server, misal:
#   /usr/bin/chromium
#   /usr/bin/chromium-browser
# Kosongkan kalau mau pakai Chrome yang didownload Puppeteer.
PUPPETEER_EXECUTABLE_PATH=

# Message Rate Limiting (anti-ban)
MSG_MIN_DELAY=3000
MSG_MAX_DELAY=5000
MSG_MAX_PER_MINUTE=10
MSG_MAX_PER_HOUR=200

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Webhook
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRIES=3

# Gemini AI (Template Pesan Chat)
# API key dari https://aistudio.google.com/apikey — jangan commit file .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=1024

# Template Pesan — rate limit endpoint AI (per menit)
TPL_MAX_PER_MINUTE=10
