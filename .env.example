# Server
PORT=3000
HOST=0.0.0.0

# WhatsApp Engine: baileys | wwjs
WA_ENGINE=baileys

# Auth
API_KEY=your-secret-api-key

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_gateway

# Redis
REDIS_URL=redis://localhost:6379

# Storage
DATA_DIR=./data

# Message Rate Limiting (anti-ban)
MSG_MIN_DELAY=3000
MSG_MAX_DELAY=5000
MSG_MAX_PER_MINUTE=10
MSG_MAX_PER_HOUR=200

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Webhook
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRIES=3
